# App
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql://radar:radar@localhost:5433/radar_financeiro

# LLM (resumo diário)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# Retry em 429/5xx (plano free do Gemini tem cota baixa)
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=2.0

# OpenAI (opcional — use LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# brapi.dev (obrigatório para FIIs e ativos fora do tier gratuito)
BRAPI_TOKEN=your-brapi-token-here
# Pausa entre requisições (plano free = 1 ativo por chamada)
BRAPI_REQUEST_DELAY_SECONDS=0.2

# MVP: ativos monitorados (separados por vírgula)
MONITORED_ASSETS=PETR4,VALE3,HGLG11,MXRF11

# Eventos corporativos (MVP 2) — janela de fatos relevantes recentes
EVENTS_LOOKBACK_DAYS=30
# Agendamento do job de eventos (horário de Brasília) — após o radar diário
EVENTS_SCHEDULE_HOUR=19
EVENTS_SCHEDULE_MINUTE=0

# Agendamento do radar diário (horário de Brasília)
# Usado como referência para o cron local — veja scripts/print-cron-entry.sh
RADAR_SCHEDULE_HOUR=18
RADAR_SCHEDULE_MINUTE=30
